      failure_modes:
        - 浮标一旦失位就不再是可用边界信号
        - 能见度不足或浑流过强时读不出泊位状态
      observability:
        - 泊位上有无浮标可直接看见
      timing: 任何在场观察时刻
      character_view:
        name: 1 号警示浮标边界信号
        actor_scope:
